# Example model config. Copy to $MODELS_DIR/<label>/serve.env and edit.
# `gwctl set --model <label>` selects which one the scheduler brings up.
#
# Everything here is non-secret: it describes WHAT to serve, never HOW to authenticate.

# Container image for the pod. PIN IT BY DIGEST — a tag can be re-pushed under you.
IMAGE=vllm/vllm-openai:v0.24.0-cu129-ubuntu2404@sha256:57f2055d534ce925817765a2f0a908027adf4ab6c1f113096a40d38af52f59a6

# Hugging Face model id, and the name clients will send as "model".
MODEL=org/Some-Model-NVFP4
SERVED_NAME=some-model

# Pin the weights to a commit, else HF `main` floats and your runs stop being reproducible.
# Find it with: curl -s https://huggingface.co/api/models/<org>/<model> | python3 -c 'import json,sys;print(json.load(sys.stdin)["sha"])'
REVISION=0000000000000000000000000000000000000000

# vLLM serving knobs.
TOOL_PARSER=hermes            # --tool-call-parser; must match the model family
REASONING_PARSER=none         # or e.g. deepseek_r1 / qwen3; `none` omits the flag
MAXLEN=131072                 # --max-model-len; must fit the KV budget of your card
EXTRA_ARGS="--max-num-seqs 128 --gpu-memory-utilization 0.90"

# Pod container disk. Weights are downloaded fresh unless you attach a network volume.
DISK_GB=80
